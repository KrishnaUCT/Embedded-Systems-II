 257:Core/Src/main.c **** float calculate_throughput(int width, int height, uint32_t time_ms){
 258:Core/Src/main.c **** 	if (time_ms == 0){
 259:Core/Src/main.c **** 		// division by zero
 260:Core/Src/main.c **** 		return 0.0f;
 261:Core/Src/main.c **** 	}
 262:Core/Src/main.c **** 	return ((float)(width*height))/((float)(time_ms)/1000.0f);
 263:Core/Src/main.c **** }
 264:Core/Src/main.c **** 
 265:Core/Src/main.c **** //TODO: Mandelbroat using variable type integers and fixed point arithmetic
 266:Core/Src/main.c **** uint64_t calculate_mandelbrot_fixed_point_arithmetic(int width, int height, int max_iterations){
 267:Core/Src/main.c ****     uint64_t mandelbrot_sum = 0;
 268:Core/Src/main.c **** 
 269:Core/Src/main.c ****     //TODO: Complete the function implementation
 270:Core/Src/main.c ****     const int32_t SCALE = 1000000;
 271:Core/Src/main.c ****     const int32_t ESCAPE = 4 * SCALE;
 272:Core/Src/main.c **** 
 273:Core/Src/main.c ****     for (int y = 0; y < height; y++){
 274:Core/Src/main.c ****     	for (int x = 0; x < width; x++){
 275:Core/Src/main.c ****     		int32_t x0 = (int32_t)(((int64_t)x * (int64_t)(3.5f * SCALE)) / width - (int64_t)(2.5f * SCAL
 276:Core/Src/main.c ****     		int32_t y0 = (int32_t)(((int64_t)y * (int64_t)(2.0f * SCALE)) / width - (int64_t)(1.0f * SCAL
 277:Core/Src/main.c **** 
 278:Core/Src/main.c ****     		int32_t xi = 0;
 279:Core/Src/main.c ****     		int32_t yi = 0;
 280:Core/Src/main.c ****     		int iteration = 0;
 281:Core/Src/main.c **** 
 282:Core/Src/main.c ****     		while (iteration < max_iterations) {
 283:Core/Src/main.c ****     			int32_t xi2 = (int32_t) (((int64_t)xi*(int64_t)xi) >> 16);
 284:Core/Src/main.c ****     			int32_t yi2 = (int32_t) (((int64_t)yi*(int64_t)yi) >> 16);
 285:Core/Src/main.c **** 
 286:Core/Src/main.c ****     			if (xi2 + yi2 > ESCAPE){
 287:Core/Src/main.c ****     				break;
 288:Core/Src/main.c ****     			}
 289:Core/Src/main.c **** 
 290:Core/Src/main.c ****     			int32_t tmp = xi2 - yi2 + x0;
 291:Core/Src/main.c ****     			yi = (int32_t)((((int64_t)xi*yi) << 1) >> 16) + y0;
 292:Core/Src/main.c ****     			xi = tmp;
 293:Core/Src/main.c **** 
 294:Core/Src/main.c ****     			iteration++;
 295:Core/Src/main.c ****     		}
 296:Core/Src/main.c ****     		mandelbrot_sum += iteration;
 297:Core/Src/main.c **** 
 298:Core/Src/main.c ****     	}
 299:Core/Src/main.c ****     }
 300:Core/Src/main.c **** 
 301:Core/Src/main.c ****     return mandelbrot_sum;
 302:Core/Src/main.c **** 
 303:Core/Src/main.c **** }
